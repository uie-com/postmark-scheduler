# Public base URL for this service. HTTP is useful for local development;
# production deployments should use HTTPS.
APP_URL=http://localhost:5555

# Slack Workflow trigger URL for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/replace-me

# Airtable credentials
AIRTABLE_API_KEY=pat_replace-me
AIRTABLE_BASE_ID=app_replace-me
AIRTABLE_TABLE_ID=tbl_replace-me

# ActiveCampaign credentials
ACTIVECAMPAIGN_API_KEY=replace-me
# The account root is accepted; /api/3 is added automatically at runtime.
ACTIVECAMPAIGN_API_URL=https://your-account.api-us1.com

# Postmark credentials
POSTMARK_API_KEY=replace-me
